# Neon pooled connection string. Keep this value server-side only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Temporary owner created by pnpm db:setup. Change both values after the first login.
ADMIN_EMAIL=admin@comuniapp.local
ADMIN_PASSWORD=ComuniApp@2026!

# Optional independent development owner. When configured, db:setup creates it
# with full owner access and without forcing an account or password update.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional public app configuration.
NEXT_PUBLIC_COMMUNITY_NAME=Bairro Mutirao | Jardim Sao Bento | SP
NEXT_PUBLIC_COMMUNITY_LAT=-23.6700
NEXT_PUBLIC_COMMUNITY_LNG=-46.7500
